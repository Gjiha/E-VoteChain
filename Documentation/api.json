						"body": {
							"mode": "raw",
							"raw": "{\n  \"id_wallet\": \"0x123abc456def\",\n  \"psw\": \"la_tua_password_qui\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/loginCheck",
							"host": ["{{base_url}}"],
							"path": ["loginCheck"]
						}
					}
				},
